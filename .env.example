# ============================================================
# Iya Ashabi Bukka Limited - POS Environment Configuration
# Copy this file to ".env" and adjust values as required.
# NEVER commit a real .env file with production secrets.
# ============================================================

# --- Core Application ---
# Secret key for session signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Development or production
APP_ENV=development

# Flask debug mode. MUST stay False in production.
DEBUG=False

# Server binding. Keep on localhost - this system is local-first.
# 127.0.0.1 means the POS is NOT reachable from the local network.
APP_HOST=127.0.0.1
APP_PORT=5000

# --- Database ---
# Leave this COMMENTED OUT for the default location:
#     %PROGRAMDATA%\IyaAshabiBukkaPOS\pos.db
# A relative path resolves against the application folder. Only uncomment
# for a deliberate location, and prefer an absolute path so a reinstall
# cannot end up pointing at the wrong file:
#DATABASE_PATH=D:\POS-Data\pos.db

# --- Hardware ---
# Windows printer name for receipts (leave empty to configure in Admin UI)
PRINTER_NAME=

# 58 or 80 (millimetres)
PRINTER_WIDTH_MM=80

# Set to True to use mock printer / drawer / display / scanner
MOCK_HARDWARE=False

# Customer display
CUSTOMER_DISPLAY_ENABLED=True

# --- Backup ---
# Integrity-checked backup of pos.db on every launch.
AUTO_BACKUP_ENABLED=True

# Where backups are written. Leave COMMENTED OUT for the default:
#     %PROGRAMDATA%\IyaAshabiBukkaPOS\backups
# Keeping copies on a second drive is safer - uncomment and use an absolute
# path:
#BACKUP_DIRECTORY=D:\POS-Backups

# How many backup files to keep; the oldest are pruned.
BACKUP_RETENTION_COUNT=30

# --- Security ---
# Idle session timeout in minutes
SESSION_TIMEOUT_MINUTES=30

# Failed login attempts before lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- First run ---
# Setup is completed automatically on first launch if this is False
SETUP_COMPLETED=False
